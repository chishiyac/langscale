{
  "name": "@langscale/react",
  "version": "1.0.1",
  "description": "React bindings for langscale.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#*": {
      "development": "./src/*.ts",
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm exec tsc -b tsconfig.json",
    "fmt:check": "pnpm exec ultracite check",
    "fmt": "pnpm exec ultracite fix",
    "type-check": "pnpm exec tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "langscale": "^1.0.0"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  }
}
