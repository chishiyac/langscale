{
  "name": "langscale-run",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "pnpm --filter langscale build && pnpm --filter @langscale/react build",
    "build": "vite build",
    "predev": "pnpm --filter langscale build && pnpm --filter @langscale/react build",
    "dev": "vite",
    "preview": "vite preview",
    "pretype-check": "pnpm --filter langscale build && pnpm --filter @langscale/react build",
    "type-check": "tsc --noEmit -p tsconfig.app.json"
  },
  "dependencies": {
    "@langscale/react": "workspace:*",
    "langscale": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.0",
    "vite": "^6.0.0"
  }
}
