{
  "compilerOptions": {
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "lib": [
      "es2024",
      "ESNext.Array",
      "ESNext.Collection",
      "ESNext.Error",
      "ESNext.Iterator",
      "ESNext.Promise",
      "DOM"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2024",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "paths": {
      "@langscale/react": [
        "../../packages/@langscale/react/src/index.ts"
      ],
      "langscale": ["../../packages/langscale/src/index.ts"]
    },
    "types": ["vite/client", "react", "react-dom"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts"]
}
