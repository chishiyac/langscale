{
  "name": "langscale-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Type-safe localization and language management for modern TypeScript applications.",
  "keywords": [
    "i18n",
    "l10n",
    "language-management",
    "localization",
    "react",
    "translation",
    "type-safe",
    "typescript"
  ],
  "homepage": "https://github.com/chishiyac/langscale#readme",
  "bugs": {
    "url": "https://github.com/chishiyac/langscale/issues"
  },
  "license": "MIT",
  "author": "chishiyac <matheussdev3@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/chishiyac/langscale.git"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/@langscale/*"
  ],
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "changeset": "changeset",
    "build": "pnpm exec tsc -b packages/langscale/tsconfig.json packages/@langscale/react/tsconfig.json",
    "dev": "pnpm --filter langscale dev",
    "fmt:check": "ultracite check",
    "fmt": "ultracite fix",
    "release": "changeset publish",
    "type-check": "pnpm build && pnpm -r type-check",
    "version": "changeset version"
  },
  "dependencies": {
    "typescript": "^5.6.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0-next.5",
    "lefthook": "^2.1.9",
    "lint-staged": "^17.0.7",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "ultracite": "7.8.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.26.2"
}
